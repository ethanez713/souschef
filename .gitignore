# Secrets — broad defensive patterns, not just the intended paths
.secrets
.secrets/
.env
.env.*
*secret*.json
*secrets*.yaml
token.json
*.pem
*.key

# Runtime data — never commit the pantry DB or receipt images
data/souschef.db
data/souschef.db-wal
data/souschef.db-shm
data/receipts/
data/cache/
data/backups/
backups/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OCR model weights (downloaded, not vendored). Anchored to the repo root: a
# bare "models/" also matches src/souschef/models/, which silently excluded the
# entire ORM package from the repo.
/models/

# Editor / OS
.vscode/
.idea/
.DS_Store
