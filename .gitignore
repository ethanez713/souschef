# Secrets — broad defensive patterns, not just the intended paths
.secrets
.secrets/
.env
.env.*
*secret*.json
*secrets*.yaml
token.json
*.pem
*.key

# Runtime data — never commit the pantry DB or receipt images.
# Globs rather than exact names: the database holds password hashes and a
# household's shopping habits, and an exact-match rule missed the obvious
# variants (souschef.db.bak, a dated copy) that show up whenever someone is
# about to do something risky and takes a backup first.
*.db
*.db-wal
*.db-shm
*.replaced
*.sqlite
*.sqlite3
*.bak
data/receipts/
data/cache/
data/backups/
backups/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OCR model weights (downloaded, not vendored). Anchored to the repo root: a
# bare "models/" also matches src/souschef/models/, which silently excluded the
# entire ORM package from the repo.
/models/

# Editor / OS
.vscode/
.idea/
.DS_Store
